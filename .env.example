# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime variables (injected automatically by AI Studio Cloud SQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Admin Seed Email (defaults to platform owner if unset)
ADMIN_EMAIL=""

# Optional Stripe configuration for production billing extension
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
